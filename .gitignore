# Python
__pycache__/
*.py[cod]
*.so
.venv/
.env

# Distribution
dist/
build/
*.egg-info/

# Tools & Caches
.mypy_cache/
.ruff_cache/
.pytest_cache/
.hypothesis/
.coverage
htmlcov/

# Generated data
benchmarks/data/*
tests/data/*

# Editors & IDEs
.idea/
.vscode/
*.swp
.DS_Store

# Ignore ephemeral benchmark runs
benchmarks/results/*

# Keep directory structure and curated golden accuracy baselines tracked
!benchmarks/results/golden/
!benchmarks/results/golden/*.json

# User specific source setups
# You can put anything here that needs to be done to prepare your env.
.user_env.*
